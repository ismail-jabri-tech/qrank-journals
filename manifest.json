{
  "manifest_version": 3,
  "name": "QRank Journals",
  "version": "1.0",
  "description": "Shows the SCImago (SJR) quartile next to journal names and ISSNs on any page.",
  "icons": { "16": "icons/on-16.png", "32": "icons/on-32.png", "48": "icons/on-48.png", "128": "icons/on-128.png" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "QRank Journals",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/on-16.png", "32": "icons/on-32.png" }
  },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["sjr.js", "content.js"], "run_at": "document_idle" }]
}
